# Public site URL used when building links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL (hostname contains -pooler) for the app.
DATABASE_URL=

# Direct Neon URL for Drizzle migrations. Same database, no -pooler in the host.
# `npm run db:migrate` refuses to do anything useful against the placeholder in drizzle.config.ts.
DATABASE_URL_UNPOOLED=

# Optional. When set, photo uploads go to Vercel Blob.
# When unset, avatar upload explains that it is off.
BLOB_READ_WRITE_TOKEN=

# Self-hosted Better Auth (same `neon_auth` tables as former Managed Neon Auth).
# Secret must be at least 32 characters: openssl rand -base64 32
# Use the same value as the old NEON_AUTH_COOKIE_SECRET when cutting over so
# existing session cookies keep working.
BETTER_AUTH_SECRET=
# Public site URL for auth callbacks (preview: PR host; production: https://www.bannquet.com).
BETTER_AUTH_URL=
# Optional comma-separated extra trusted origins (each PR preview host, if needed).
BETTER_AUTH_TRUSTED_ORIGINS=
# Legacy name still read if BETTER_AUTH_SECRET is unset during migration.
NEON_AUTH_COOKIE_SECRET=

# Comma-separated. These addresses can sign in without an invite and become admins.
ADMIN_EMAIL=

# Optional. Password reset emails send from this address via Resend when both are set.
# Verify the domain in Resend (e.g. bannquet.com) and use something like noreply@bannquet.com.
RESEND_API_KEY=
EMAIL_FROM=

# Optional USGS Water Data API key from api.data.gov. Sent as X-Api-Key and api_key.
# Without it, mountain fishing still loads, on the no-key rate limit (50 requests per hour per IP).
# WATER_DATA_API_KEY is accepted as another name for the same key.
USGS_WATER_DATA_API_KEY=
