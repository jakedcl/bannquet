# Public site URL used when building links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL (hostname contains -pooler) for the app.
DATABASE_URL=

# Direct Neon URL for Drizzle migrations. Same database, no -pooler in the host.
# `npm run db:migrate` refuses to do anything useful against the placeholder in drizzle.config.ts.
DATABASE_URL_UNPOOLED=

# One-off Sanity import. The website does not read these.
# Dry run (no writes): npm run db:migrate-sanity -- --dry-run
# Import: CONFIRM_SANITY_MIGRATION=yes npm run db:migrate-sanity
# Point DATABASE_URL at a Neon branch, not production, the first time you run it.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Optional. When set, the import copies report images into Vercel Blob,
# and profile photos on /settings upload there too.
# When unset, photo rows keep the Sanity CDN URL and avatar upload explains that it is off.
BLOB_READ_WRITE_TOKEN=

# Neon Auth. The first two names match the Neon console. The cookie secret is extra
# and must be at least 32 characters: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# Comma-separated. These addresses can sign in without an invite and become admins.
ADMIN_EMAIL=
